tsconfig.json
tsdown.config.ts
vitest.config.mjs

# CI and repo meta — not useful to npm consumers
.github/
CLAUDE.md
changelog/

# Dev/test artifacts
node_modules/
.git/

# Docs and examples are useful for npm — intentionally not excluded
